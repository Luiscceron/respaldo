<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: #f4f6f9;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controlador.FacturacionController">
    <padding>
        <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
    </padding>
    <children>
        <Label style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1f2937;" text="Historial de Reservas y Facturación" />

        <VBox alignment="CENTER" maxWidth="780.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 12, 0, 0, 4);">
            <padding>
                <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
            </padding>
            <children>
                <Label fx:id="lblResumenFacturacion" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1f2937;" text="Total Facturado: $0 | Reservas Confirmadas: 0" />
                <TextArea fx:id="txtHistorialFacturas" editable="false" prefHeight="260.0" prefWidth="730.0" style="-fx-font-family: 'Consolas', monospace; -fx-font-size: 14px;" />
            </children>
        </VBox>

        <Button mnemonicParsing="false" onAction="#exportarReporte" prefHeight="48.0" prefWidth="280.0" style="-fx-background-color: #e59a16; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="Exportar reporte_facturas.txt" />
    </children>
</VBox>
