<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: #f4f6f9;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controlador.RecepcionController">
    <padding>
        <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
    </padding>
    <children>
        <Label style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1f2937;" text="Cola de Atención en Recepción (FIFO)" />

        <VBox alignment="CENTER_LEFT" maxWidth="780.0" spacing="12.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 12, 0, 0, 4);">
            <padding>
                <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
            </padding>
            <children>
                <Label fx:id="lblFrenteCola" style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #d97706;" text="Siguiente en atender: Ninguno" />
                <TextArea fx:id="txtListaCola" editable="false" prefHeight="260.0" prefWidth="730.0" style="-fx-font-family: 'Consolas', monospace; -fx-font-size: 14px;" />
            </children>
        </VBox>

        <HBox alignment="CENTER" spacing="20.0">
            <children>
                <Button mnemonicParsing="false" onAction="#confirmarSiguiente" prefHeight="48.0" prefWidth="260.0" style="-fx-background-color: #e59a16; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="Confirmar Siguiente (Desencolar)" />
                <Button mnemonicParsing="false" onAction="#rechazarSiguiente" prefHeight="48.0" prefWidth="220.0" style="-fx-background-color: white; -fx-border-color: #d1d5db; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 15px; -fx-text-fill: #374151; -fx-cursor: hand;" text="Rechazar Solicitud" />
            </children>
        </HBox>
    </children>
</VBox>
