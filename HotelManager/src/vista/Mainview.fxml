<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane id="AnchorPane" prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: #f4f6f9;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controlador.MainController">
    <children>
        <!-- BARRA SUPERIOR AZUL OSCURO (100px para simetría exacta con la cabecera naranja) -->
        <AnchorPane prefHeight="100.0" style="-fx-background-color: #1c2536;" AnchorPane.leftAnchor="250.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />

        <!-- ÁREA CENTRAL DINÁMICA (Aquí se intercambiarán las vistas del menú) -->
        <StackPane fx:id="contenedorCentral" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="250.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="100.0">
            <children>
                <VBox alignment="CENTER" spacing="25.0">
                    <children>
                        <!-- FILA CENTRAL: Botón Anterior + Tarjeta Blanca + Botón Siguiente -->
                        <HBox alignment="CENTER" spacing="45.0">
                            <children>
                                <Button mnemonicParsing="false" onAction="#btnAnteriorClick" prefHeight="48.0" prefWidth="125.0" style="-fx-background-color: white; -fx-border-color: #d1d5db; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 15px; -fx-text-fill: #374151; -fx-cursor: hand;" text="&lt;  Anterior" />

                                <!-- TARJETA BLANCA DE LA HABITACIÓN -->
                                <VBox alignment="CENTER" prefHeight="490.0" prefWidth="580.0" spacing="8.0" style="-fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.12), 14, 0, 0, 4); -fx-background-radius: 10;">
                                    <padding>
                                        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
                                    </padding>
                                    <children>
                                        <StackPane prefHeight="300.0" prefWidth="530.0">
                                            <children>
                                                <ImageView fx:id="imgHabitacion" fitHeight="300.0" fitWidth="530.0" preserveRatio="true" />
                                            </children>
                                        </StackPane>

                                        <Label fx:id="lblNumeroHabitacion" alignment="CENTER" prefWidth="530.0" style="-fx-font-size: 25px; -fx-font-weight: bold; -fx-text-fill: #1f2937;" text="Habitación: 201">
                                            <VBox.margin>
                                                <Insets top="10.0" />
                                            </VBox.margin>
                                        </Label>
                                        <Label fx:id="lblTipoHabitacion" alignment="CENTER" prefWidth="530.0" style="-fx-font-size: 17px; -fx-text-fill: #4b5563;" text="Tipo: Suite VIP" />
                                        <Label fx:id="lblPrecioHabitacion" alignment="CENTER" prefWidth="530.0" style="-fx-font-size: 16px; -fx-text-fill: #4b5563;" text="Precio: $200.000 / noche" />
                                        <Label fx:id="lblEstadoHabitacion" alignment="CENTER" prefWidth="530.0" style="-fx-font-size: 16px; -fx-text-fill: #4b5563;" text="Estado: Disponible" />
                                    </children>
                                </VBox>

                                <Button mnemonicParsing="false" onAction="#btnSiguienteClick" prefHeight="48.0" prefWidth="125.0" style="-fx-background-color: white; -fx-border-color: #d1d5db; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 15px; -fx-text-fill: #374151; -fx-cursor: hand;" text="Siguiente  &gt;" />
                            </children>
                        </HBox>

                        <!-- BOTÓN INFERIOR DE RESERVA -->
                        <Button fx:id="btnReservar" mnemonicParsing="false" onAction="#abrirFormularioReserva" prefHeight="52.0" prefWidth="360.0" style="-fx-background-color: #e59a16; -fx-text-fill: white; -fx-font-size: 17px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 6, 0, 0, 2); -fx-cursor: hand;" text="Reservar esta habitación" />
                    </children>
                </VBox>
            </children>
        </StackPane>

        <!-- MENÚ LATERAL OSCURO -->
        <AnchorPane prefHeight="720.0" prefWidth="250.0" style="-fx-background-color: #1c2536;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <!-- CABECERA NARANJA DEL MENÚ -->
                <AnchorPane prefHeight="100.0" prefWidth="250.0" style="-fx-background-color: #e59a16;">
                    <children>
                        <Label layoutX="80.0" layoutY="38.0" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 18px;" text="HOTELMANAGER" />
                        <ImageView fx:id="imgLogo" fitHeight="48.0" fitWidth="48.0" layoutX="20.0" layoutY="26.0" preserveRatio="true">
                            <image>
                                <Image url="@../imagenes/logo.png" />
                            </image>
                        </ImageView>
                    </children>
                </AnchorPane>

                <!-- BOTONES DEL MENÚ CON SUS ID Y ACCIONES -->
                <VBox layoutX="15.0" layoutY="130.0" prefWidth="220.0" spacing="12.0">
                    <children>
                        <Button fx:id="btnMenuRecepcion" mnemonicParsing="false" onAction="#mostrarRecepcion" prefHeight="46.0" prefWidth="220.0" style="-fx-background-color: #243046; -fx-text-fill: white; -fx-alignment: BASELINE_LEFT; -fx-padding: 0 0 0 20; -fx-font-size: 15px; -fx-background-radius: 6; -fx-cursor: hand;" text="Recepción" />
                        <Button fx:id="btnMenuHabitaciones" mnemonicParsing="false" onAction="#mostrarHabitaciones" prefHeight="46.0" prefWidth="220.0" style="-fx-background-color: #e59a16; -fx-text-fill: white; -fx-alignment: BASELINE_LEFT; -fx-padding: 0 0 0 20; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Habitaciones" />
                        <Button fx:id="btnMenuFacturacion" mnemonicParsing="false" onAction="#mostrarFacturacion" prefHeight="46.0" prefWidth="220.0" style="-fx-background-color: #243046; -fx-text-fill: white; -fx-alignment: BASELINE_LEFT; -fx-padding: 0 0 0 20; -fx-font-size: 15px; -fx-background-radius: 6; -fx-cursor: hand;" text="Facturación" />
                        <Button fx:id="btnMenuCancelaciones" mnemonicParsing="false" onAction="#mostrarCancelaciones" prefHeight="46.0" prefWidth="220.0" style="-fx-background-color: #243046; -fx-text-fill: white; -fx-alignment: BASELINE_LEFT; -fx-padding: 0 0 0 20; -fx-font-size: 15px; -fx-background-radius: 6; -fx-cursor: hand;" text="Cancelaciones" />
                        <Button fx:id="btnMenuLimpieza" mnemonicParsing="false" onAction="#mostrarLimpieza" prefHeight="46.0" prefWidth="220.0" style="-fx-background-color: #243046; -fx-text-fill: white; -fx-alignment: BASELINE_LEFT; -fx-padding: 0 0 0 20; -fx-font-size: 15px; -fx-background-radius: 6; -fx-cursor: hand;" text="Limpieza" />
                    </children>
                </VBox>
            </children>
        </AnchorPane>
    </children>
</AnchorPane>